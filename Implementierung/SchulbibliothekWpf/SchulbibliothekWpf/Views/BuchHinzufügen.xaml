<Window x:Class="SchulbibliothekWpf.Views.BuchHinzufügen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchulbibliothekWpf.Views"
        mc:Ignorable="d"
        Title="BuchHinzufügen" Height="450" Width="400">
    <Grid>
        
        
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>



        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Button Content="x" Grid.Column="2" Height="25" Width="25" VerticalAlignment="Top" HorizontalAlignment="Right"></Button>
        

        <TextBlock Padding="10" Text="Titel:" Grid.Row="0" FontFamily="Britannic Bold" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <TextBox x:Name="TitelBox" HorizontalAlignment="Left" Grid.Column="2" Width="200" Height="20"></TextBox>


        <TextBlock Padding="10" Text="Autor:" Grid.Row="1" FontFamily="Britannic Bold" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <TextBox x:Name="AutorBox" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2" Width="200" Height="20"></TextBox>


        <TextBlock Padding="10" Text="ISBN:" Grid.Row="2" FontFamily="Britannic Bold" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <TextBox x:Name="IsbnBox" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="2" Width="200" Height="20"></TextBox>


        <TextBlock Padding="10" Text="ErscheinungsJahr:" Grid.Row="3" FontFamily="Britannic Bold" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <TextBox x:Name="JahrBox" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="2" Width="200" Height="20"></TextBox>

        <Button Content="Bestätigen" Click="Bestätigen_Click" Grid.Row="4" Grid.ColumnSpan="2" Height="30" Width="200" ></Button>





    </Grid>
</Window>
