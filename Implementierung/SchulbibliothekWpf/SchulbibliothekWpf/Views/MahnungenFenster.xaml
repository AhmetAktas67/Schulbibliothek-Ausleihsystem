<Window x:Class="SchulbibliothekWpf.Views.MahnungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchulbibliothekWpf.Views"
        mc:Ignorable="d"
        Title="MahnungenFenster" Height="450" Width="800">
    
    
    <Grid Margin="10">

        <DataGrid ItemsSource="{Binding Mahnungen}"
          AutoGenerateColumns="False"
          IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Buch"
                            Binding="{Binding Buch.Titel}"
                            Width="*"/>

                <DataGridTextColumn Header="Benutzer"
                            Binding="{Binding Nutzername}"
                            Width="150"/>

                <DataGridTextColumn Header="Ausgeliehen am"
                            Binding="{Binding DatumAusleihe}"
                            Width="150"/>

                <DataGridTextColumn Header="Rückgabe in Verzug seit"
                            Binding="{Binding TageImVerzug}"
                            Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
